{
    "cmake.useCMakePresets": "never",
    "cmake.generator": "Unix Makefiles",
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.buildBeforeRun": true,
    "cmake.debugConfig": {
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/local/bin/gdb-root",
        "externalConsole": false
    }
}